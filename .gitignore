# Local datasets, recordings, and audit backups. Keep their folder guides in Git.
/02_Datasets/*
!/02_Datasets/README.md
/03_Recordings/*
!/03_Recordings/README.md
/04_Models_and_Experiments/*
!/04_Models_and_Experiments/README.md
/99_Organization/*
!/99_Organization/README.md

# Windows shortcuts contain machine-specific absolute paths.
# Portable scripts, URL files, and documentation are tracked instead.
/05_Run/*
!/05_Run/README.md
!/05_Run/*.ps1
!/05_Run/*.url

# Model weights and generated inference exports are local artifacts.
*.pt
*.pth
*.safetensors
*.onnx
*.onnx.data
*.sentis

# Local credentials and operating-system files.
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
desktop.ini
